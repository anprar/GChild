# GChild development environment. Salin menjadi .env lalu isi nilai lokal.
# JANGAN commit .env. Tidak ada nilai secret nyata di file ini.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/gchild.sqlite
LOG_LEVEL=info

# Wajib diisi: minimal 32 karakter acak. Server menolak start jika kosong.
# Contoh membuat nilai: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAIRING_CODE_PEPPER=replace-with-32-plus-random-bytes

# Kanal Parent: bot Telegram. Token disimpan hanya di server, tidak pernah di APK.
# Buat bot lewat @BotFather dan tempel token di .env lokal ini.
TELEGRAM_BOT_TOKEN=
# Allowlist tambahan (lapis kedua). Kosongkan untuk mengandalkan tabel family_members.
TELEGRAM_PARENT_IDS=

# Tidak ada password/session Parent: identitas Parent adalah telegram_user_id.
PAIRING_CODE_TTL_SECONDS=600
ENROLLMENT_TTL_SECONDS=900
COMMAND_TTL_SECONDS=120
COMMAND_LEASE_SECONDS=30
STATUS_STALE_SECONDS=900
RETENTION_DAYS=30
TELEGRAM_NOTIFIER_INTERVAL_MS=5000
